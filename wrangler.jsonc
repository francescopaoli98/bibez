{
  // Gym Coach su Cloudflare Workers: file statici di gym-coach/ + API in worker/index.js
  "name": "gym-f98-x7k",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-08",
  "assets": {
    "directory": "./gym-coach",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Archivio degli account. Senza "id": Cloudflare lo crea da solo alla prima pubblicazione.
  "kv_namespaces": [{ "binding": "APP" }]
}
