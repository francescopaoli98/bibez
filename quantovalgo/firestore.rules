rules_version = '2';

// Regole di sicurezza di QuantoValgo.
// Ogni persona legge e scrive SOLO i propri dati, sotto utenti/{uid}.
// Tutto il resto è vietato (anche a chi ha fatto l'accesso).
service cloud.firestore {
  match /databases/{database}/documents {

    match /utenti/{uid} {
      // Profilo dell'utente
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // Lavori, costi, clienti ecc.: tutte le raccolte sotto il profilo
      match /{percorso=**} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Qualsiasi altro percorso: negato
    match /{altro=**} {
      allow read, write: if false;
    }
  }
}
